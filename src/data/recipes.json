      "blurb": "Hard sear, butter baste, steakhouse crust. Date night handled.",
      "servings": 2,
      "prep": 10,
      "cook": 15,
      "heat": 1,
      "ingredients": [
        {
          "q": 2,
          "u": "",
          "i": "ribeye steaks, 1¼ inch thick (about 12 oz each)"
        },
        {
          "q": 1,
          "u": "tbsp",
          "i": "Prime Steak blend",
          "blend": true
        },
        {
          "q": 1,
          "u": "tbsp",
          "i": "neutral oil"
        },
        {
          "q": 3,
          "u": "tbsp",
          "i": "butter"
        },
        {
          "q": 4,
          "u": "cloves",
          "i": "garlic, smashed"
        },
        {
          "q": 3,
          "u": "sprigs",
          "i": "fresh thyme"
        },
        {
          "q": null,
          "u": "",
          "i": "flaky salt, to finish"
        }
      ],
      "steps": [
        {
          "t": "Pat the steaks dry and season every side with Prime Steak. Let them sit uncovered at room temperature.",
          "min": 40
        },
        {
          "t": "Heat a cast-iron pan on high until it just starts to smoke, then add the oil."
        },
        {
          "t": "Lay in the steaks and sear without moving them. Flip once and sear the other side for the same time.",
          "min": 3
        },
        {
          "t": "Drop to medium. Add butter, garlic and thyme, tilt the pan and baste for 1–2 minutes, until the center reads 130°F (54°C) for medium-rare."
        },
        {
          "t": "Rest on a board, then slice against the grain. Spoon over the pan butter and finish with flaky salt.",
          "min": 8
        }
      ],
      "tip": "Hands off while it sears. Moving the steak breaks the crust."
    },
