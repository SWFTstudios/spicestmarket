        {
          "q": null,
          "u": "",
          "i": "ketchup and hot sauce, to taste"
        }
      ],
      "steps": [
        {
          "t": "Cook the bacon in a skillet over medium heat until crisp. Set it aside and keep about 1 tbsp of the fat in the pan.",
          "min": 6
        },
        {
