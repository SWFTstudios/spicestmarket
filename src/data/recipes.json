      "servings": 4,
      "prep": 15,
      "cook": 25,
      "heat": 0,
      "ingredients": [
        {
          "q": 1,
          "u": "cup",
          "i": "self-rising flour, plus more for dusting"
        },
        {
          "q": 1,
          "u": "cup",
          "i": "full-fat plain Greek yogurt"
        },
        {
          "q": 1,
          "u": "",
          "i": "egg, beaten (egg wash)"
        },
        {
          "q": 2,
          "u": "tbsp",
          "i": "Everything Bagel blend",
          "blend": true
        },
        {
          "q": null,
          "u": "",
          "i": "cream cheese, for serving"
        }
      ],
      "steps": [
        {
          "t": "Heat the oven to 375°F (190°C) and line a sheet pan with parchment."
        },
        {
          "t": "Stir the flour and yogurt into a shaggy dough. Knead on a floured counter for 2–3 minutes, until smooth and no longer sticky."
        },
        {
          "t": "Cut into 4 pieces. Roll each into an 8-inch rope and pinch the ends together into a ring."
        },
        {
          "t": "Brush with egg wash, then press the tops firmly into a plate of Everything Bagel blend."
        },
        {
          "t": "Bake until deep golden. Let them cool for 10 minutes; they finish setting as they cool.",
          "min": 25
